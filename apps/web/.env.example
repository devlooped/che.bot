# Copy to .env for `pnpm dev:live` and set them for `pnpm build`. Public: they end up in the
# browser bundle. The Auth0 tenant, the client id of its single-page application, and the
# identifier of the API it requests tokens for (the Worker's AUTH0_AUDIENCE).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
