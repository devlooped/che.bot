{
  "name": "@chebot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode fakes",
    "dev:live": "vite dev --port 3000 --strictPort",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite build && vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/app/tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run && vitest run -c vitest.app.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@chebot/charts": "workspace:*",
    "@chebot/driver": "workspace:*",
    "@chebot/protocol": "workspace:*",
    "@chebot/providers": "workspace:*",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ai": "^7.0.173",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0",
    "zod": "^4.6.7"
  }
}
