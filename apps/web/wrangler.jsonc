{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chebot-web",
  "account_id": "c1d5bf025f41490ee30de77958f9fa35",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The built single-page app. With the Cloudflare Vite plugin the directory is the client build
  // (the plugin writes it into the deploy config); /api/*, the sign-in routes /auth/* and the pages
  // of runs /r/* (which may redirect to a run's link) always reach the Worker, and any other path
  // that is not a file gets index.html.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/r/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RUNS", "class_name": "RunObject" },
      { "name": "SPEND", "class_name": "SpendMeter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunObject", "SpendMeter"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chebot",
      "database_id": "8a33c4fd-eea6-4335-b2ff-76108ed6635f",
      "migrations_dir": "migrations"
    }
  ],
  // The brake on POST /api/runs: questions per user and minute, counted per Cloudflare location
  // and approximate (the daily cap bounds the spend). namespace_id is any integer unique in the
  // account.
  "ratelimits": [
    { "name": "ASK_LIMITER", "namespace_id": "4201", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    // The budget of one question in USD; empty means the protocol's default (RunConfig.budgetUsd).
    "RUN_BUDGET_USD": "",
    // The global spend cap of a day (UTC) in USD. A new question is refused when the worst case
    // of a run (its budget) does not fit; a paid run is never refused.
    "DAILY_CAP_USD": "25",
    // "true" at launch: any signed-in user may ask. Until then, only the Admin and Contrib roles.
    "LAUNCHED": "false"
  },
  "secrets": {
    "required": [
      "AI_GATEWAY_API_KEY",
      "JOBS_URL",
      "JOBS_TOKEN",
      "AUTH0_DOMAIN",
      "AUTH0_CLIENT_ID",
      "AUTH0_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  }
}
